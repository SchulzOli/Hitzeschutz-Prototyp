{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SchulzOli/Hitzeschutz-Prototyp/schema/kuehle-orte.schema.json",
  "title": "Kühle Orte und Kühle Räume – Datenschema v0.1 (Entwurf)",
  "description": "GeoJSON-FeatureCollection mit öffentlich zugänglichen Orten, die bei Hitze Abkühlung bieten. Entwurf für einen gemeinsamen Austauschstandard zwischen Kommunen, Ländern und Anwendungen.",
  "type": "object",
  "required": ["type", "features", "metadaten"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "metadaten": { "$ref": "#/$defs/metadaten" },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/kuehlerOrt" }
    }
  },
  "$defs": {
    "metadaten": {
      "type": "object",
      "description": "Angaben zum Datensatz als Ganzes (orientiert an DCAT-AP.de).",
      "required": ["herausgeber", "lizenz", "stand"],
      "properties": {
        "herausgeber": { "type": "string", "description": "Veröffentlichende Stelle, z. B. 'Stadt Musterstadt, Gesundheitsamt'." },
        "ags": { "type": "string", "pattern": "^[0-9]{2,12}$", "description": "Amtlicher Gemeinde- bzw. Regionalschlüssel des Gebiets." },
        "lizenz": { "type": "string", "description": "Lizenzkennung, bevorzugt 'dl-de/by-2-0', 'dl-de/zero-2-0' oder 'CC-BY-4.0'." },
        "stand": { "type": "string", "format": "date" },
        "kontakt": { "type": "string" },
        "schemaVersion": { "const": "0.1" }
      }
    },
    "kuehlerOrt": {
      "type": "object",
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "type": "string", "minLength": 1, "description": "Stabile, im Datensatz eindeutige Kennung." },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Point" },
            "coordinates": {
              "type": "array",
              "description": "[Längengrad, Breitengrad] in WGS 84 (EPSG:4326).",
              "prefixItems": [
                { "type": "number", "minimum": -180, "maximum": 180 },
                { "type": "number", "minimum": -90, "maximum": 90 }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "properties": { "$ref": "#/$defs/eigenschaften" }
      }
    },
    "eigenschaften": {
      "type": "object",
      "required": ["name", "kategorie", "quelle"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kategorie": {
          "enum": ["kuehler_raum", "trinkwasser", "bibliothek", "gotteshaus", "museum", "park", "badestelle", "sonstiges"],
          "description": "kuehler_raum = von einer Stelle ausdrücklich als Hitze-Schutzraum ausgewiesener Innenraum."
        },
        "offiziell_ausgewiesen": { "type": "boolean", "description": "true, wenn eine Kommune oder Behörde den Ort ausdrücklich als Kühlen Ort/Raum ausweist." },
        "beschreibung": { "type": "string" },
        "adresse": { "type": "string" },
        "oeffnungszeiten": { "type": "string", "description": "Syntax wie OpenStreetMap 'opening_hours', z. B. 'Mo-Fr 10:00-18:00'." },
        "innenraum": { "type": "boolean" },
        "klimatisiert": { "type": "boolean" },
        "trinkwasser_kostenlos": { "type": "boolean" },
        "sitzgelegenheiten": { "type": "boolean" },
        "toilette": { "type": "boolean" },
        "barrierefrei": { "enum": ["ja", "teilweise", "nein"] },
        "kostenfrei": { "type": "boolean" },
        "betreiber": { "type": "string" },
        "website": { "type": "string", "format": "uri" },
        "quelle": { "type": "string", "description": "Herkunft des Eintrags, z. B. 'OpenStreetMap' oder Name der Kommune." },
        "quelle_id": { "type": "string", "description": "Kennung im Quellsystem, z. B. 'node/123456'." },
        "lizenz": { "type": "string" },
        "stand": { "type": "string", "format": "date" }
      }
    }
  }
}
